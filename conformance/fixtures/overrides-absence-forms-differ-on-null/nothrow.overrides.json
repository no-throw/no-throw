{
  "$schema": "https://no-throw.github.io/no-throw/schema/v1/nothrow.overrides.schema.json",
  "version": 1,
  "packages": {
    "flaky": {
      "exports": {
        ".": {
          "untilUndefined": {
            "color": "non-throwing",
            "conditions": [
              "param0=undefined"
            ]
          },
          "untilNullish": {
            "color": "non-throwing",
            "conditions": [
              "param0=nullish"
            ]
          }
        }
      }
    }
  }
}
