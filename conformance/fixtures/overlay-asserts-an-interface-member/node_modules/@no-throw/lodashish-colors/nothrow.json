{
  "$schema": "https://midnightdesign.github.io/no-throw/nothrow.schema.json",
  "version": 1,
  "package": "lodashish",
  "exports": {
    ".": {
      "LoDashStatic#chunk": {
        "color": "non-throwing",
        "conditions": []
      },
      "LoDashStatic#detonate": {
        "color": "throwing"
      },
      "LoDashStatic#version": {
        "accessor": {
          "get": "throwing",
          "set": "throwing"
        }
      }
    }
  }
}
