{
  "name": "@no-throw/dom-baseline-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Maintainer-side tooling: generates the DOM baseline shipped in @no-throw/core, and the CI gates that keep it maintainable.",
  "scripts": {
    "fetch-specs": "node dist/bin/fetch-specs.js",
    "fetch-gecko": "node dist/bin/fetch-gecko.js",
    "generate": "node dist/bin/generate.js",
    "gate:fuzz": "node dist/bin/gate-fuzz.js",
    "gate:deferred": "node dist/bin/gate-deferred.js",
    "gate:drift": "node dist/bin/gate-drift.js"
  },
  "dependencies": {
    "@no-throw/core": "workspace:*",
    "@webref/idl": "^3.82.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "web-specs": "^3.30.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2"
  }
}
