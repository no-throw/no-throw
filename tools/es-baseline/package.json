    "gate:drift": "node dist/bin/gate-drift.js"
  },
  "dependencies": {
    "@nothrow/core": "workspace:*",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
