{
  "name": "@nothrow/es-baseline-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Maintainer-side tooling: generates the ES baseline shipped in @nothrow/core, and the two CI gates that keep it maintainable.",
