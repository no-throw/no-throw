{
  "name": "no-throw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Statically enforce that no throw escapes a function marked @nothrow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no-throw/no-throw.git"
  },
  "homepage": "https://github.com/no-throw/no-throw#readme",
  "bugs": "https://github.com/no-throw/no-throw/issues",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check:lockstep": "node scripts/check-lockstep.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "audit:diagnostics": "node scripts/audit-diagnostics.mjs",
    "check:packed": "node scripts/check-packed.mjs",
    "conformance": "node conformance/dist/run.js",
    "conformance:cli": "node conformance/dist/run-cli.js",
    "test": "pnpm run build && pnpm run check:lockstep && pnpm run check:docs && pnpm run conformance && pnpm run conformance:cli && pnpm run audit:diagnostics",
    "gate:peer:eslint": "node scripts/gate-eslint-peer.mjs",
    "gate:peer:typescript": "node scripts/gate-typescript-peer.mjs",
    "baseline:generate": "pnpm --filter @no-throw/es-baseline-tools run generate",
    "gate:fuzz": "pnpm --filter @no-throw/es-baseline-tools run gate:fuzz",
    "gate:drift": "pnpm --filter @no-throw/es-baseline-tools run gate:drift",
    "dom:generate": "pnpm --filter @no-throw/dom-baseline-tools run generate",
    "dom:gate:fuzz": "pnpm --filter @no-throw/dom-baseline-tools run gate:fuzz",
    "dom:gate:deferred": "pnpm --filter @no-throw/dom-baseline-tools run gate:deferred",
    "dom:gate:drift": "pnpm --filter @no-throw/dom-baseline-tools run gate:drift",
    "dogfood:scc": "pnpm --filter @no-throw/dogfood run scc",
    "dogfood:cycles": "pnpm --filter @no-throw/dogfood run cycles",
    "dogfood:cold": "pnpm --filter @no-throw/dogfood run cold",
    "dogfood:warm": "pnpm --filter @no-throw/dogfood run warm"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
